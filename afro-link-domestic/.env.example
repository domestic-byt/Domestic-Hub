# Afro-Link Domestic API
PORT=3000

# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=https://afro-link.domestic.com.et,https://domestic.com.et,https://domestic-hub.vercel.app

# Optional: enables the Mistral LLM adapter for the Domestic AI Agent
MISTRAL_API_KEY=

# Optional: PostgreSQL connection string; when set, the API persists to Postgres
DATABASE_URL=

# Optional: HMAC secret for DomesticHub SSO tokens (HS256 JWTs). When set,
# all write endpoints require a Bearer token; reads stay public.
AUTH_SECRET=

# Telebirr gateway (optional). When set, fuel advances disburse/recover via the
# live Telebirr SuperApp API instead of the simulated adapter.
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_BASE_URL=
TELEBIRR_TIMEOUT_MS=

# CBE Birr gateway (optional). Requires an explicit base URL.
CBE_BIRR_CLIENT_ID=
CBE_BIRR_CLIENT_SECRET=
CBE_BIRR_BASE_URL=
CBE_BIRR_TIMEOUT_MS=
